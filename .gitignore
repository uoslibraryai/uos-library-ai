# Python cache - never needed on GitHub
__pycache__/
*.py[cod]

# Virtual environments - large, and recreated from requirements.txt
venv/
.venv/
env/

# Streamlit secrets - NEVER upload API keys or tokens.
# Note: .gitignore only prevents NEW files from being added.
# It does not remove a secret that is already tracked - so this
# file must be in place BEFORE any secrets file is ever uploaded.
.streamlit/secrets.toml

# Local editor / operating system files
.vscode/
.DS_Store
